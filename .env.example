# 音乐平台 Cookie 配置（当前音乐时光仅支持网易云）
# VIP 歌曲需要配置网易云 Cookie 才能获取完整播放链接
# 从浏览器登录 music.163.com 后，F12 -> Application -> Cookies 获取

# 网易云音乐（需要 VIP 账号）
# 必需字段：__csrf, MUSIC_U, NMTID, __remember_me
METING_NETEASE_COOKIE=

# 通用 Cookie（作为网易云 fallback）
# METING_COOKIE=

# TripStar 旅行智能体
# 无大模型配置时建议先开启 mock 模式，确保页面和任务闭环可用
TRIPSTAR_ENABLED=true
TRIPSTAR_MOCK_MODE=true

# 真实旅行规划需要兼容 OpenAI Chat Completions 的大模型配置
TRIPSTAR_LLM_MODEL_ID=
TRIPSTAR_LLM_API_KEY=
TRIPSTAR_LLM_BASE_URL=
TRIPSTAR_LLM_TIMEOUT=600

# 高德 Web 服务 Key；为空时后端会复用当前项目内置高德 Key
TRIPSTAR_AMAP_WEB_KEY=

# 小红书能力第一阶段默认关闭；开启后需要提供网页登录 Cookie
TRIPSTAR_ENABLE_XHS=false
TRIPSTAR_XHS_COOKIE=

# Google Maps 可选配置
TRIPSTAR_GOOGLE_MAPS_API_KEY=
TRIPSTAR_GOOGLE_MAPS_PROXY=
