# 音乐平台 Cookie 配置（当前音乐时光仅支持网易云）
# VIP 歌曲需要配置网易云 Cookie 才能获取完整播放链接
# 从浏览器登录 music.163.com 后，F12 -> Application -> Cookies 获取

# 网易云音乐（需要 VIP 账号）
# 必需字段：__csrf, MUSIC_U, NMTID, __remember_me
METING_NETEASE_COOKIE=

# 通用 Cookie（作为网易云 fallback）
# METING_COOKIE=

# 首次建库凭据（仅数据库缺记录时使用；已有值永不自动覆盖）
# 留空时服务会自动生成随机值并写入 tmp/initial_credentials.txt
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=
INITIAL_GALLERY_PASSWORD=
INITIAL_INVITE_CODE=

# 会话与跨域
# 生产 HTTPS 环境必须设为 true
COOKIE_SECURE=false
SESSION_TTL_SECONDS=2592000
# 需要跨域开发时填写，例如 http://localhost:5173；默认只允许同源
CORS_ORIGINS=
# 仅在服务位于可信反向代理之后时开启
TRUST_PROXY_HEADERS=false

# 高德 Web 服务 Key（后端天气、POI、路线使用）
AMAP_KEY=

# TripStar 旅行智能体
# 无 AI API Key 时会自动使用 mock，确保页面和任务闭环可用
TRIPSTAR_ENABLED=true
TRIPSTAR_MOCK_MODE=true

# 单一 OpenAI 兼容 AI 接口（AI 助手与 TripStar 共用）
# 运行时优先读取 love_config；仅当数据库值为空时才使用同名环境变量兜底
# responses=Responses API（默认）；chat_completions=Chat Completions
AI_CHAT_BASE_URL=
AI_CHAT_API_KEY=
# 模型可选；DeepSeek/Grok/Codex 等按上游要求填写，留空时请求不发送 model
AI_CHAT_MODEL=
AI_CHAT_API_MODE=responses

# 高德 Web 服务 Key（后端地理编码/POI/路线）
TRIPSTAR_AMAP_WEB_KEY=

# 高德 JS API Key 与安全密钥（MapView / ExpressView / TripStar 前端地图）
# 也可以通过用户管理页写入 love_config
VITE_TRIPSTAR_AMAP_WEB_JS_KEY=
VITE_TRIPSTAR_AMAP_SECURITY_JS_CODE=

# 小红书能力第一阶段默认关闭；开启后需要提供网页登录 Cookie
TRIPSTAR_ENABLE_XHS=false
TRIPSTAR_XHS_COOKIE=

# Google Maps 可选配置
TRIPSTAR_GOOGLE_MAPS_API_KEY=
TRIPSTAR_GOOGLE_MAPS_PROXY=
